{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folio",
  "version": "0.1.0",
  "identifier": "com.folio.reader",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Folio",
        "width": 1280,
        "height": 800,
        "minWidth": 420,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data: blob:; img-src 'self' blob: data:; frame-src blob:; connect-src 'self' ipc: http://ipc.localhost blob:",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data: blob:; img-src 'self' blob: data:; frame-src blob:; connect-src 'self' ipc: http://ipc.localhost blob: ws://localhost:1420 http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "A beautiful, easy-to-use EPUB reader",
    "longDescription": "Folio is an EPUB reader with themes, comfortable zoom at any screen size, highlights, notes, bookmarks, in-book search and reading statistics. Your books and notes stay on your device.",
    "copyright": "Copyright (c) 2026 HadiAbu. Licensed under the Apache License 2.0.",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "fileAssociations": [
      { "ext": ["epub"], "name": "EPUB Book", "description": "EPUB e-book", "mimeType": "application/epub+zip", "role": "Viewer" },
      { "ext": ["mobi"], "name": "MOBI Book", "description": "Mobipocket e-book", "mimeType": "application/x-mobipocket-ebook", "role": "Viewer" },
      { "ext": ["azw3"], "name": "AZW3 Book", "description": "Kindle (AZW3) e-book", "mimeType": "application/vnd.amazon.ebook", "role": "Viewer" },
      { "ext": ["fb2"], "name": "FB2 Book", "description": "FictionBook e-book", "mimeType": "application/x-fictionbook+xml", "role": "Viewer" },
      { "ext": ["cbz"], "name": "Comic Book Archive", "description": "Comic book archive (CBZ)", "mimeType": "application/vnd.comicbook+zip", "role": "Viewer" }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
